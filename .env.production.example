# Application
NODE_ENV=production
APP_URL=https://itsm.example.com
HOST=0.0.0.0
PORT=3000

# Auth / 2FA — AUTH_SECRET is preferred; JWT_SECRET and NEXTAUTH_SECRET also work
AUTH_SECRET=replace-with-a-64-char-random-string
# JWT_SECRET=
# NEXTAUTH_SECRET=
TWO_FACTOR_ENCRYPTION_KEY=replace-with-a-separate-32-plus-char-key
TWO_FACTOR_ISSUER=Nexus SM

# Database
# Neon: DATABASE_URL = pooled (-pooler) connection; DIRECT_URL = non-pooled connection
# Local Docker / single host: set both to the same URL
DATABASE_URL=postgresql://itsm:replace-strong-password@db:5432/itsm?schema=public
DIRECT_URL=postgresql://itsm:replace-strong-password@db:5432/itsm?schema=public

# Compose Postgres service
POSTGRES_USER=itsm
POSTGRES_PASSWORD=replace-strong-password
POSTGRES_DB=itsm
